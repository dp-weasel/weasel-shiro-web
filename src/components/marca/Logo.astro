---
// Logo (armiño con auriculares) sobre el círculo naranja de la marca.
// Es un SVG (vectorizado del PNG original), así que se ve nítido en cualquier tamaño.
import { Image } from "astro:assets";
import logo from "../../assets/brand/weasel-auriculares.svg"; // = RecursosCC/pngTuber/weasel-auriculares.svg (optimizado con svgo)

interface Props {
  /** Diámetro del círculo, en cualquier unidad CSS. */
  size?: string;
}
const { size = "9rem" } = Astro.props;
---

<div class="badge" style={`--size: ${size}`}>
  <Image
    src={logo}
    alt="Weasel Shiro: armiño blanco con auriculares"
    height={480}
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  .badge {
    width: var(--size);
    height: var(--size);
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--vermilion), var(--amber));
    box-shadow: 0 .5rem 1.5rem rgb(230 74 25 / .35);
    /* El círculo recorta el corte del cuello del dibujo. */
    overflow: hidden;
  }
  /* El dibujo es vertical (≈ 0,77:1): se ajusta por alto, un poco más grande que el
     círculo y bajado un 4 % para que no se corte la vincha de los auriculares. */
  img {
    display: block;
    height: 105%;
    width: auto;
    margin: 4% auto 0;
  }
</style>
